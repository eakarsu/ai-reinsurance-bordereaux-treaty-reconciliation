// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model Treaty {
  id        String   @id @default(cuid())
  name String
  reinsurer String
  type String
  layer String
  limitUsd Float
  cessionPct Float
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bordereauRecords BordereauRecord[]
  cededPremiums CededPremium[]
  lossRecoverables LossRecoverable[]
  cashCalls CashCall[]
  collateralPositions CollateralPosition[]
  commutationReviews CommutationReview[]
  scheduleFEntrys ScheduleFEntry[]
  reinsurerCounterpartys ReinsurerCounterparty[]
  discrepancyCases DiscrepancyCase[]
  settlementPayments SettlementPayment[]
  treatyTerms TreatyTerm[]
}

model BordereauRecord {
  id        String   @id @default(cuid())
  period String
  kind String
  rowCount Int
  fileRef String
  status String
  receivedAt DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CededPremium {
  id        String   @id @default(cuid())
  period String
  grossWritten Float
  cededAmount Float
  commission Float
  currency String
  status String
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LossRecoverable {
  id        String   @id @default(cuid())
  claimRef String
  period String
  incurredLoss Float
  recoverable Float
  status String
  recognizedAt DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashCall {
  id        String   @id @default(cuid())
  callRef String
  amount Float
  currency String
  status String
  issuedAt DateTime?
  settledAt DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollateralPosition {
  id        String   @id @default(cuid())
  reinsurer String
  instrument String
  requiredAmount Float
  heldAmount Float
  status String
  asOf DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommutationReview {
  id        String   @id @default(cuid())
  proposalRef String
  analyst String
  settlementAmount Float
  status String
  proposedAt DateTime?
  rationale String?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleFEntry {
  id        String   @id @default(cuid())
  naicCode String
  reinsurerName String
  part String
  amount Float
  status String
  statementYear String
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReinsurerCounterparty {
  id        String   @id @default(cuid())
  name String
  amBestRating String
  domicile String
  status String
  exposureLimit Float
  lastReview DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscrepancyCase {
  id        String   @id @default(cuid())
  kind String
  expectedValue String
  reportedValue String
  variance Float
  status String
  owner String
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SettlementPayment {
  id        String   @id @default(cuid())
  period String
  direction String
  amount Float
  currency String
  status String
  dueDate DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TreatyTerm {
  id        String   @id @default(cuid())
  clause String
  category String
  text String
  version String
  status String
  effectiveDate DateTime?
  treatyId String?
  treaty Treaty? @relation(fields: [treatyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}
